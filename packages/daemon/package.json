{
  "name": "@conductor/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx --no-warnings=ExperimentalWarning src/smoke.ts",
    "spike": "tsx --no-warnings=ExperimentalWarning src/session/spike.ts",
    "spike:copilot": "tsx --no-warnings=ExperimentalWarning src/session/backends/copilot-spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@conductor/shared": "workspace:*",
    "@fastify/http-proxy": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "@github/copilot-sdk": "1.0.16",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.0",
    "marked": "^15.0.6",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "@types/ws": "^8.5.13"
  }
}
